LoadPlugin("plugins\ffms2-5.0-msvc\x64\ffms2.dll")        
# декодер для MP4/MKV
FFVideoSource("clip.mp4")          
# открываем видео через FFMS2
Trim(120, 240)                        
# вырезаем из видео кадры с 120 по 240
Crop(0, 200, 0, -200)                  
# отрезаем сверху и снизу по 200 пикселей
LanczosResize(1280, 720)               
# уменьшаем разрешение до 1280x720
ConvertToYV12()                        
# цветовой формат, ожидаемый энкодером x264
AssumeFPS(24000, 1001)                 
# частотв кадров 23.976
